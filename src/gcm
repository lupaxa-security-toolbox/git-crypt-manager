#!/usr/bin/env bash
# ==============================================================================
# git-crypt Manager
# ==============================================================================
# Full lifecycle management for git-crypt encrypted repositories
#
# Features:
#   • Setup git-crypt + .gitattributes rules (requires a clean repo)
#   • Add, rotate, revoke users (GPG) and auto-commit git-crypt metadata
#   • List current git-crypt collaborators from .git-crypt/keys
#   • Nuclear key rotation
#   • Remove encryption going forward (auto-commit .gitattributes)
#   • Encrypted JSON audit logs
#   • Backup & restore git-crypt configuration
#   • Simple doctor command for diagnostics
#   • CLI subcommands (interactive prompts when args omitted; argv supported)
#   • Cross-platform: macOS + Linux
# ==============================================================================

set -euo pipefail

SCRIPT_NAME="gcm"
VERSION="1.0.0"

BACKUP_DIR_BASE=".git-crypt-backups"
LOG_DIR=".git-crypt-logs"

GCM_ATTR_BEGIN="# BEGIN gcm git-crypt setup (auto-generated)"
GCM_ATTR_END="# END gcm git-crypt setup (auto-generated)"
# Legacy marker (pre-marker-pair setups); still recognised for unencrypt/doctor.
GCM_ATTR_LEGACY_MARKER="git-crypt setup (auto-generated)"

# OS-portable sed
if [[ "$OSTYPE" == "darwin"* ]]; then
    SED_CMD=(sed -i '')
else
    SED_CMD=(sed -i)
fi

# ------------------------------------------------------------------------------
# Logging helpers
# ------------------------------------------------------------------------------

json_escape() {
    # Escape a string for inclusion inside a JSON double-quoted value.
    local s=${1-}
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "${s}"
}

init_logs_dir() {
    local ensure_attrs="${1:-true}"
    mkdir -p "${LOG_DIR}"
    # Ensure logs are encrypted by git-crypt (idempotent). Skip when read-only.
    if [[ "${ensure_attrs}" == "true" ]] \
        && [[ -f .gitattributes ]] \
        && ! grep -qF "${LOG_DIR}/**" .gitattributes 2>/dev/null; then
        {
            echo
            echo "# Audit logs encrypted (auto-added):"
            echo "${LOG_DIR}/** filter=git-crypt diff=git-crypt"
        } >> .gitattributes || true
    fi
}

# write_log ACTION RESULT WARNINGS KEY EMAIL TRUST [stage=true|false]
write_log() {
    local action="$1" result="$2" warnings="$3" key="$4" email="$5" trust="$6"
    local stage="${7:-true}"

    init_logs_dir true
    local ts
    ts="$(date -u +"%Y%m%dT%H%M%SZ")"
    local file="${LOG_DIR}/${ts}-${action}.json"

    local git_name git_email git_actor gpg_actor
    git_name="$(git config --get user.name 2>/dev/null || true)"
    git_email="$(git config --get user.email 2>/dev/null || true)"
    if [[ -n "${git_name}" || -n "${git_email}" ]]; then
        git_actor="${git_name} <${git_email}>"
    else
        git_actor=""
    fi
    gpg_actor="$(gpg --list-secret-keys --keyid-format=long 2>/dev/null \
        | grep '^uid' | head -n1 | sed 's/^.*] //' || true)"

    cat > "${file}" <<EOF
{
  "timestamp": "$(json_escape "${ts}")",
  "version": "$(json_escape "${VERSION}")",
  "action": "$(json_escape "${action}")",
  "actor_git": "$(json_escape "${git_actor}")",
  "actor_gpg": "$(json_escape "${gpg_actor}")",
  "result": "$(json_escape "${result}")",
  "warnings": "$(json_escape "${warnings}")",
  "key_fingerprint": "$(json_escape "${key}")",
  "email": "$(json_escape "${email}")",
  "trust": "$(json_escape "${trust}")"
}
EOF

    if [[ "${stage}" == "true" ]]; then
        git add "${file}" >/dev/null 2>&1 || true
    fi
}

# ------------------------------------------------------------------------------
# Generic helpers
# ------------------------------------------------------------------------------

msg(){ printf '%s\n' "$*"; }
err(){ printf 'ERROR: %s\n' "$*" >&2; }

require_cmds() {
    local missing=()
    local c
    for c in "$@"; do
        if ! command -v "${c}" >/dev/null 2>&1; then
            missing+=("${c}")
        fi
    done
    if ((${#missing[@]} > 0)); then
        err "Missing required command(s): ${missing[*]}"
        return 1
    fi
    return 0
}

require_repo(){
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || { err "Run inside a Git repository"; return 1; }
}

ensure_backup_gitignore() {
    local gi=".gitignore"
    if [[ -f "${gi}" ]] && grep -qxF "${BACKUP_DIR_BASE}/" "${gi}" 2>/dev/null; then
        return 0
    fi
    {
        echo
        echo "# gcm: local backups contain git-crypt key material — do not commit"
        echo "${BACKUP_DIR_BASE}/"
    } >> "${gi}"
}

trust_for_key() {
    gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '/^pub/ {print $2; exit}'
}

check_trust(){
    local key="$1"
    local trust
    trust="$(trust_for_key "${key}")"

    # Trust levels (for reference):
    #   - unknown: e
    #   - none:    n
    #   - marginal: m
    #   - full:     f
    #   - ultimate: u
    #
    # We require: f or u

    if [[ -z "${trust}" ]]; then
        err "No trust record found for key '${key}'. Is it imported?"
        return 1
    fi

    case "${trust}" in
        f|u)
            return 0
            ;;
        *)
            err "GPG key '${key}' is NOT trusted enough (trust level: '${trust}')."
            echo >&2
            echo "To trust this key, run:" >&2
            echo "    gpg --edit-key \"${key}\"" >&2
            echo "    trust" >&2
            echo "    (select 4 = full trust)" >&2
            echo "    quit" >&2
            echo >&2
            echo "Then re-run the command:" >&2
            echo "    ${SCRIPT_NAME} add-users" >&2
            echo >&2
            return 1
            ;;
    esac
}

fingerprint_for_key(){
    gpg --list-keys --with-colons "$1" 2>/dev/null | awk -F: '/^fpr/ {print $10; exit}'
}

email_for_key(){
    gpg --list-keys "$1" 2>/dev/null | grep '^uid' | head -1 | sed 's/^.*] //' || true
}

commit_git_crypt_changes() {
    local message="$1"
    git add .git-crypt .gitattributes "${LOG_DIR}" 2>/dev/null || true
    if ! git diff --cached --quiet 2>/dev/null; then
        git commit -m "${message}"
        msg "[OK] Committed git-crypt metadata changes."
    else
        msg "[INFO] No git-crypt metadata changes to commit."
    fi
}

has_gcm_attr_block() {
    [[ -f .gitattributes ]] || return 1
    grep -qF "${GCM_ATTR_LEGACY_MARKER}" .gitattributes 2>/dev/null
}

remove_gcm_attr_block() {
    # Prefer begin/end markers; fall back to legacy fixed-window delete.
    if grep -qF "${GCM_ATTR_END}" .gitattributes 2>/dev/null; then
        local tmp
        tmp="$(mktemp)"
        awk -v begin="${GCM_ATTR_BEGIN}" -v end="${GCM_ATTR_END}" '
            $0 == begin { skip = 1; next }
            $0 == end   { skip = 0; next }
            !skip { print }
        ' .gitattributes > "${tmp}"
        mv "${tmp}" .gitattributes
    elif grep -qF "${GCM_ATTR_LEGACY_MARKER}" .gitattributes 2>/dev/null; then
        # Legacy setups wrote a fixed-size block without an end marker.
        "${SED_CMD[@]}" "/git-crypt setup (auto-generated)/,+15d" .gitattributes || true
    fi
}

print_help() {
    cat <<EOF
${SCRIPT_NAME} v${VERSION}

Usage:
  ${SCRIPT_NAME} <command> [args]

Commands:
  setup           Initialise git-crypt and write .gitattributes rules (clean repo only)
  add-users       Add one or more GPG users as git-crypt collaborators
  rotate-user     Rotate a user's GPG key (add new, then revoke old)
  revoke-user     Revoke a GPG user from git-crypt
  list-users      List current git-crypt collaborators
  nuclear-rotate  Regenerate the git-crypt encryption key (dangerous)
  unencrypt       Remove git-crypt rules for future commits
  doctor          Run basic diagnostics (read-only)
  backup          Backup .git-crypt and .gitattributes
  restore         Restore latest backup of .git-crypt and .gitattributes
  version         Show script version
  help            Show this help text

Examples:
  ${SCRIPT_NAME} setup
  ${SCRIPT_NAME} add-users
  ${SCRIPT_NAME} add-users alice@example.com bob@example.com
  ${SCRIPT_NAME} rotate-user old@example.com new@example.com
  ${SCRIPT_NAME} revoke-user alice@example.com
  ${SCRIPT_NAME} list-users
  ${SCRIPT_NAME} doctor

When key arguments are omitted, add/rotate/revoke prompt interactively (same as before).
EOF
}

# ------------------------------------------------------------------------------
# Setup (clean repo only)
# ------------------------------------------------------------------------------

setup(){
    require_cmds git git-crypt gpg || return 1
    require_repo || return 1

    # Enforce: setup only on a clean repo (no staged or unstaged changes)
    if [[ -n "$(git status --porcelain)" ]]; then
        err "setup must be run on a clean repository (no staged or unstaged changes)."
        err "Please commit or stash your changes and try again."
        return 1
    fi

    # If git-crypt has never been initialised in this repo, do it now.
    # We just check for the .git-crypt directory, which 'git-crypt init' creates.
    if [[ ! -d ".git-crypt" ]]; then
        echo "[INFO] Initialising git-crypt…"
        git-crypt init
    fi

    ensure_backup_gitignore

    # Ensure .gitattributes contains the standard git-crypt block
    if ! has_gcm_attr_block; then
        cat <<EOF >> .gitattributes

${GCM_ATTR_BEGIN}
* filter=git-crypt diff=git-crypt

# Explicit plaintext-only
.gitattributes !filter !diff
.git-crypt/** !filter !diff
${BACKUP_DIR_BASE}/ !filter !diff

# Explicit plaintext-only
README.md !filter !diff
*.md !filter !diff
docs/** !filter !diff
.github/** !filter !diff
.gitignore !filter !diff

# Audit logs encrypted:
${LOG_DIR}/** filter=git-crypt diff=git-crypt
${GCM_ATTR_END}
EOF
        echo "[OK] Wrote git-crypt .gitattributes rules."
    else
        echo "[OK] .gitattributes already contains git-crypt rules."
    fi

    # Initialise logs dir and record a setup log
    init_logs_dir true
    write_log "setup" "success" "" "" "" "" true
    echo "[OK] Encryption rules applied and setup logged."

    # Auto-commit everything we changed so we end clean again
    git add .gitattributes .gitignore .git-crypt "${LOG_DIR}" 2>/dev/null || true
    if ! git diff --cached --quiet 2>/dev/null; then
        git commit -m "Initial git-crypt setup"
        echo "[OK] Committed git-crypt setup and logs."
    else
        echo "[INFO] No changes to commit."
    fi
}

# ------------------------------------------------------------------------------
# Add / rotate / revoke users (auto-commit git-crypt metadata)
# ------------------------------------------------------------------------------

add_one_user() {
    local key="$1"
    check_trust "${key}" || return 1

    local fp email trust
    fp="$(fingerprint_for_key "${key}")"
    email="$(email_for_key "${key}")"
    trust="$(trust_for_key "${key}")"

    if ! git-crypt add-gpg-user "${key}"; then
        err "git-crypt add-gpg-user failed for '${key}'."
        err "Make sure the repo was initialised with 'git-crypt init' or '${SCRIPT_NAME} setup' and your GPG key is imported."
        return 1
    fi

    write_log "add-user" "success" "" "${fp}" "${email}" "${trust}" true

    if [[ -n "${email}" ]]; then
        msg "[OK] Added GPG user: ${email} (${fp})"
    else
        msg "[OK] Added GPG user: ${key} (${fp})"
    fi
}

add_users(){
    require_cmds git git-crypt gpg || return 1
    require_repo || return 1
    init_logs_dir true

    local keys=()
    if [[ $# -gt 0 ]]; then
        keys=("$@")
    else
        local count i key
        read -r -p "How many users? " count
        if ! [[ "${count}" =~ ^[0-9]+$ ]] || (( count < 1 )); then
            err "Expected a positive integer for user count."
            return 1
        fi
        for ((i=0; i<count; i++)); do
            read -r -p "GPG key identifier (email, fingerprint, or key ID) for user $((i+1)): " key
            keys+=("${key}")
        done
    fi

    local key
    for key in "${keys[@]}"; do
        add_one_user "${key}" || return 1
    done

    commit_git_crypt_changes "git-crypt collaborator update"
}

rotate_one_user() {
    local old="$1"
    local new="$2"

    # Collect + validate both keys before mutating (safer than revoke-then-add).
    local fp email trust fp2 email2 trust2
    fp="$(fingerprint_for_key "${old}")"
    email="$(email_for_key "${old}")"
    trust="$(trust_for_key "${old}")"

    check_trust "${new}" || return 1
    fp2="$(fingerprint_for_key "${new}")"
    email2="$(email_for_key "${new}")"
    trust2="$(trust_for_key "${new}")"

    if ! git-crypt add-gpg-user "${new}"; then
        err "git-crypt add-gpg-user failed for '${new}'."
        err "Old key '${old}' was NOT revoked."
        return 1
    fi
    write_log "rotate-user" "updated" "" "${fp2}" "${email2}" "${trust2}" true

    if ! git-crypt revoke-gpg-user "${old}"; then
        err "git-crypt revoke-gpg-user failed for '${old}' after adding '${new}'."
        err "Both keys may currently be collaborators — fix manually, then re-run if needed."
        write_log "rotate-user" "partial" "revoke-failed-after-add" "${fp}" "${email}" "${trust}" true
        return 1
    fi
    write_log "rotate-user" "revoked" "" "${fp}" "${email}" "${trust}" true

    msg "[OK] Rotation complete: ${old} → ${new}"
}

rotate_user(){
    require_cmds git git-crypt gpg || return 1
    require_repo || return 1
    init_logs_dir true

    if [[ $# -gt 0 ]]; then
        if (( $# % 2 != 0 )); then
            err "rotate-user expects pairs: OLD_KEY NEW_KEY [OLD_KEY NEW_KEY ...]"
            err "Or run with no args for interactive prompts."
            return 1
        fi
        local args=("$@")
        local i
        for ((i=0; i<${#args[@]}; i+=2)); do
            echo "== Rotation: ${args[i]} → ${args[i+1]} =="
            rotate_one_user "${args[i]}" "${args[i+1]}" || return 1
        done
    else
        local count i old new
        read -r -p "How many users do you want to rotate? " count
        if ! [[ "${count}" =~ ^[0-9]+$ ]] || (( count < 1 )); then
            err "Expected a positive integer for user count."
            return 1
        fi
        for ((i=0; i<count; i++)); do
            echo "== Rotation $((i+1)) of ${count} =="
            read -r -p "GPG key identifier (email, fingerprint, or key ID) to rotate: " old
            read -r -p "New GPG key identifier (email, fingerprint, or key ID): " new
            rotate_one_user "${old}" "${new}" || return 1
        done
    fi

    commit_git_crypt_changes "git-crypt collaborator rotation"
}

revoke_one_user() {
    local key="$1"
    local fp email trust
    fp="$(fingerprint_for_key "${key}")"
    email="$(email_for_key "${key}")"
    trust="$(trust_for_key "${key}")"

    if ! git-crypt revoke-gpg-user "${key}"; then
        err "git-crypt revoke-gpg-user failed for '${key}'."
        return 1
    fi
    write_log "revoke-user" "success" "" "${fp}" "${email}" "${trust}" true
    msg "[OK] Revoked GPG user ${key}."
}

revoke_user(){
    require_cmds git git-crypt gpg || return 1
    require_repo || return 1
    init_logs_dir true

    local keys=()
    if [[ $# -gt 0 ]]; then
        keys=("$@")
    else
        local count i key
        read -r -p "How many users do you want to revoke? " count
        if ! [[ "${count}" =~ ^[0-9]+$ ]] || (( count < 1 )); then
            err "Expected a positive integer for user count."
            return 1
        fi
        for ((i=0; i<count; i++)); do
            echo "== Revocation $((i+1)) of ${count} =="
            read -r -p "GPG key identifier (email, fingerprint, or key ID) to revoke: " key
            keys+=("${key}")
        done
    fi

    local key
    for key in "${keys[@]}"; do
        revoke_one_user "${key}" || return 1
    done

    commit_git_crypt_changes "git-crypt collaborator revoke"
}

# ------------------------------------------------------------------------------
# List current collaborators
# ------------------------------------------------------------------------------

list_users() {
    require_cmds git gpg || return 1
    require_repo || return 1

    if [[ ! -d ".git-crypt/keys" ]]; then
        echo "[INFO] No git-crypt collaborators found (no .git-crypt/keys directory)."
        return 0
    fi

    echo "Current git-crypt collaborators:"
    # Find all *.gpg under .git-crypt/keys, sort them for stable output
    # Filenames are of the form: .git-crypt/keys/default/0/<FINGERPRINT>.gpg
    local any=false
    while IFS= read -r -d '' f; do
        any=true
        local base fp uid
        base="${f##*/}"          # e.g. 117A6C729AA3...F941ECDB9735D048.gpg
        fp="${base%.gpg}"        # strip .gpg
        # Try to resolve to a local GPG uid (may fail if we don't have that pubkey locally)
        uid="$(gpg --list-keys "${fp}" 2>/dev/null | grep '^uid' | head -1 | sed 's/^.*] //' || true)"
        if [[ -n "${uid}" ]]; then
            echo "  - ${fp}  (${uid})"
        else
            echo "  - ${fp}  (no local GPG uid)"
        fi
    done < <(find .git-crypt/keys -type f -name '*.gpg' -print0 2>/dev/null | sort -z)

    if [[ "${any}" == false ]]; then
        echo "  (none)"
    fi
}

# ------------------------------------------------------------------------------
# Nuclear rotation
# ------------------------------------------------------------------------------

nuclear_rotate(){
    require_cmds git git-crypt gpg || return 1
    require_repo || return 1

    msg "WARNING: Full encryption key reset!"
    msg "This will attempt to re-initialise git-crypt. Existing ciphertext may become unreadable"
    msg "until collaborators are re-added and the tree is renormalised."
    read -r -p "Are you absolutely sure? (yes/no): " c
    [[ "$c" == "yes" ]] || { err "Aborted"; return 1; }

    # Always take a local backup first (does not dirty git via audit log staging).
    ensure_backup_gitignore
    local repo ts backup
    repo="$(git rev-parse --show-toplevel)"
    ts="$(date +%Y%m%d-%H%M%S)"
    backup="${repo}/${BACKUP_DIR_BASE}/${ts}-pre-nuclear"
    mkdir -p "${backup}"
    if [[ -d "${repo}/.git-crypt" ]]; then
        cp -a "${repo}/.git-crypt" "${backup}/" || {
            err "Failed to back up .git-crypt; aborting nuclear-rotate."
            return 1
        }
    fi
    if [[ -f "${repo}/.gitattributes" ]]; then
        cp "${repo}/.gitattributes" "${backup}/" || true
    fi
    msg "[OK] Pre-rotate backup: ${backup}"

    init_logs_dir true
    if ! git-crypt init; then
        err "git-crypt init failed (repo may already be initialised)."
        err "Restore from backup if needed: ${backup}"
        err "Typical recovery still requires re-adding users and: git add --renormalize . && git commit"
        return 1
    fi

    write_log "nuclear-rotate" "success" "" "" "" "" true
    git add "${LOG_DIR}" 2>/dev/null || true
    msg "[OK] New encryption key generated."
    msg "Next steps:"
    msg "  1. Re-add collaborators: ${SCRIPT_NAME} add-users"
    msg "  2. Renormalise: git add --renormalize . && git commit && git push"
}

# ------------------------------------------------------------------------------
# Remove encryption going forward (auto-commit .gitattributes)
# ------------------------------------------------------------------------------

unencrypt(){
    require_cmds git || return 1
    require_repo || return 1

    if [[ ! -f .gitattributes ]]; then
        msg "[INFO] .gitattributes not found; nothing to remove."
    else
        remove_gcm_attr_block

        git add .gitattributes
        if ! git diff --cached --quiet -- .gitattributes 2>/dev/null; then
            git commit -m "Remove git-crypt encryption rules" -- .gitattributes
            msg "[OK] Committed removal of git-crypt rules."
        else
            msg "[INFO] No changes to .gitattributes to commit."
        fi
    fi

    write_log "unencrypt" "success" "" "" "" "" true
    msg "[OK] Encryption removed for future commits."
}

# ------------------------------------------------------------------------------
# Doctor (simple diagnostics — read-only; does not stage or commit)
# ------------------------------------------------------------------------------

doctor(){
    require_repo || return 1

    local ok=true
    local status_output=""
    local status_exit=0

    echo "== git-crypt doctor =="

    local c
    for c in git git-crypt gpg; do
        if command -v "${c}" >/dev/null 2>&1; then
            echo "[OK] ${c} found: $(command -v "${c}")"
        else
            echo "[FAIL] ${c} not found on PATH."
            ok=false
        fi
    done

    local git_name git_email
    git_name="$(git config --get user.name 2>/dev/null || true)"
    git_email="$(git config --get user.email 2>/dev/null || true)"
    if [[ -n "${git_name}" && -n "${git_email}" ]]; then
        echo "[OK] git identity: ${git_name} <${git_email}>"
    else
        echo "[WARN] git user.name / user.email not fully configured."
    fi

    if command -v git-crypt >/dev/null 2>&1; then
        status_output="$(git-crypt status 2>&1 || true)"
        status_exit=$?

        if echo "${status_output}" | grep -qi "not initialized"; then
            echo "[FAIL] git-crypt is not initialised in this repository."
            ok=false
        else
            echo "[OK] git-crypt appears to be initialised."
            if [[ ${status_exit} -ne 0 ]]; then
                echo "[WARN] git-crypt status reported issues:"
                echo
                echo "${status_output}"
                echo
                echo "Hint: run 'git-crypt status -f' and then commit to re-encrypt any affected files."
            fi
        fi
    fi

    # Simple .gitattributes presence + block check
    if [[ -f .gitattributes ]]; then
        if has_gcm_attr_block; then
            echo "[OK] .gitattributes contains git-crypt rules."
        else
            echo "[WARN] .gitattributes exists but does not contain the auto-generated git-crypt block."
        fi
    else
        echo "[WARN] .gitattributes file is missing."
    fi

    if [[ -d "${BACKUP_DIR_BASE}" ]]; then
        if [[ -f .gitignore ]] && grep -qxF "${BACKUP_DIR_BASE}/" .gitignore 2>/dev/null; then
            echo "[OK] ${BACKUP_DIR_BASE}/ is gitignored."
        else
            echo "[WARN] ${BACKUP_DIR_BASE}/ exists but is not listed in .gitignore (contains key material)."
        fi
    fi

    if [[ "${ok}" == true && ${status_exit} -eq 0 ]]; then
        echo
        echo "Repository looks healthy."
        return 0
    else
        echo
        echo "Repository has issues. See messages above."
        return 1
    fi
}

# ------------------------------------------------------------------------------
# Backup / Restore
# ------------------------------------------------------------------------------

backup_config(){
    require_cmds git || return 1
    require_repo || return 1

    # Do not write/stage audit logs here — backups must not dirty the worktree.
    ensure_backup_gitignore

    local repo ts backup
    repo="$(git rev-parse --show-toplevel)"
    ts="$(date +%Y%m%d-%H%M%S)"
    backup="${repo}/${BACKUP_DIR_BASE}/${ts}"

    mkdir -p "${backup}"
    local copied=false
    if [[ -d "${repo}/.git-crypt" ]]; then
        cp -a "${repo}/.git-crypt" "${backup}/" || {
            err "Failed to copy .git-crypt into backup."
            return 1
        }
        copied=true
    fi
    if [[ -f "${repo}/.gitattributes" ]]; then
        cp "${repo}/.gitattributes" "${backup}/" || {
            err "Failed to copy .gitattributes into backup."
            return 1
        }
        copied=true
    fi

    if [[ "${copied}" != true ]]; then
        err "Nothing to back up (.git-crypt and .gitattributes missing)."
        rmdir "${backup}" 2>/dev/null || true
        return 1
    fi

    printf 'gcm backup %s\n' "${ts}" > "${backup}/BACKUP.txt"
    msg "[OK] Backup created: ${backup}"
    msg "[INFO] Backups contain key material and should stay out of git (${BACKUP_DIR_BASE}/)."
}

restore_config(){
    require_cmds git || return 1
    require_repo || return 1

    local repo latest
    repo="$(git rev-parse --show-toplevel)"
    latest="$(find "${repo}/${BACKUP_DIR_BASE}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | tail -1)"

    [[ -z "${latest}" ]] && { err "No backups available"; return 1; }

    if [[ ! -d "${latest}/.git-crypt" ]]; then
        err "Backup is incomplete (missing .git-crypt): ${latest}"
        return 1
    fi

    cp -a "${latest}/.git-crypt" "${repo}/" || {
        err "Failed to restore .git-crypt from ${latest}"
        return 1
    }
    if [[ -f "${latest}/.gitattributes" ]]; then
        cp "${latest}/.gitattributes" "${repo}/" || {
            err "Failed to restore .gitattributes from ${latest}"
            return 1
        }
    else
        msg "[WARN] Backup has no .gitattributes; left current file unchanged."
    fi

    msg "[OK] Restored from: ${latest}"
}

# ------------------------------------------------------------------------------
# CLI
# ------------------------------------------------------------------------------

if [[ $# -eq 0 ]]; then
    print_help
    exit 1
fi

cmd="$1"; shift || true
case "$cmd" in
    version|--version)
        echo "${SCRIPT_NAME} v${VERSION}"
        exit 0
        ;;
    help|-h|--help)
        print_help
        exit 0
        ;;
    setup)           setup "$@" ;;
    add-users)       add_users "$@" ;;
    rotate-user)     rotate_user "$@" ;;
    revoke-user)     revoke_user "$@" ;;
    list-users)      list_users "$@" ;;
    nuclear-rotate)  nuclear_rotate "$@" ;;
    unencrypt)       unencrypt "$@" ;;
    doctor)          doctor "$@" ;;
    backup)          backup_config "$@" ;;
    restore)         restore_config "$@" ;;
    *)
        err "Unknown command: $cmd"
        echo
        print_help
        exit 1
        ;;
esac
